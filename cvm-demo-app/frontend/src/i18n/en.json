    "dedup_rules_list": [
      { "rule": "DFP over ITR", "description": "When both an annual (DFP) and a quarterly (ITR) filing cover the same period and account, the annual filing takes priority. This prevents double-counting the same data at different granularities." },
      { "rule": "Standalone ITR over YTD", "description": "Q2 and Q3 ITR filings include two row sets: standalone quarterly figures (e.g., Apr–Jun) and YTD cumulative figures (e.g., Jan–Jun). Standalone rows are preferred; YTD rows are only kept when no standalone row exists for that period." },
      { "rule": "Monetary scale normalization", "description": "CVM filings report values in either UNIDADE (raw BRL) or MIL (thousands). All values are normalized to thousands (÷ 1000 where ESCALA_MOEDA = UNIDADE) before the accounts are pivoted into the model." }
